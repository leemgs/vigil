\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Temporal precedent-graph ablation (main claim). Both mechanisms of Eq.~\eqref  {eq:tpg_score} are removed in sequence; the bottom row recovers flat semantic similarity. Full gating cuts the stale-citation rate from 12.7\% to 4.1\% while improving PLRE F1 by 0.06. Stale-cite measures citations to already-closed precedent ($t_q\!\ge \!e_v$).}}{7}{table.caption.8}\protected@file@percent }
\newlabel{tab:temporal_ablation}{{5}{7}{Temporal precedent-graph ablation (main claim). Both mechanisms of Eq.~\eqref {eq:tpg_score} are removed in sequence; the bottom row recovers flat semantic similarity. Full gating cuts the stale-citation rate from 12.7\% to 4.1\% while improving PLRE F1 by 0.06. Stale-cite measures citations to already-closed precedent ($t_q\!\ge \!e_v$)}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Edge-error propagation audit. Gold row substitutes labels on the 600 annotated spans only. ``Mask $x$\%'' rows also remove $x$\% of extracted negative-treatment edges (closures or down-weights). Effective miss rate $\approx 1-0.77(1-x)$ from the extractor's 0.77 recall; $\Delta $F1 is relative to the extractor row.}}{7}{table.caption.9}\protected@file@percent }
\newlabel{tab:edge_sensitivity}{{6}{7}{Edge-error propagation audit. Gold row substitutes labels on the 600 annotated spans only. ``Mask $x$\%'' rows also remove $x$\% of extracted negative-treatment edges (closures or down-weights). Effective miss rate $\approx 1-0.77(1-x)$ from the extractor's 0.77 recall; $\Delta $F1 is relative to the extractor row}{table.caption.9}{}}
